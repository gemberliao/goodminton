{
  "id": "./",
  "name": "GOODMINTON 羽球隊智慧管理系統",
  "short_name": "GOODMINTON",
  "description": "球隊活動、出缺席、帳務與隊員資料的一站式管理 App。",
  "lang": "zh-Hant-TW",
  "dir": "ltr",
  "start_url": "./#/login",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#f8fafc",
  "theme_color": "#059669",
  "categories": ["sports", "productivity", "utilities"],
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "球隊月曆",
      "short_name": "月曆",
      "url": "./#/member/calendar",
      "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "個人帳單",
      "short_name": "帳單",
      "url": "./#/member/finances",
      "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
